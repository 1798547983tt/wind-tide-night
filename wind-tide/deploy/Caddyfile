# wind-tide: Caddy in front of 风与潮之夜. SITE_ADDRESS and SITE_HOST come
# from .env: https://<domain> and <domain>.
{
	# Browsers name no site (SNI) when they open an IP address, and inside
	# Docker the connection's own address is the container's, so without a
	# default Caddy finds no certificate for them and the handshake fails.
	default_sni {$SITE_HOST}
}

{$SITE_ADDRESS} {
	# Without a domain, on the server's IP address, the site needs this block
	# here (wind-tide/DEPLOY.md §7): Let's Encrypt issues IP address
	# certificates only under its six-day "shortlived" profile.
	#   tls {
	#   	issuer acme {
	#   		profile shortlived
	#   	}
	#   }

	encode zstd gzip

	header {
		# The site is invite-only; keep it out of search engines.
		X-Robots-Tag "noindex, nofollow"
		-Server
		# Other sites may not show the console in a frame (clickjacking).
		Content-Security-Policy "frame-ancestors 'self'"
		X-Frame-Options SAMEORIGIN
		# Browsers keep to HTTPS on this domain for a year (they ignore it on
		# an IP address), so plain HTTP never works there again for them.
		Strict-Transport-Security "max-age=31536000"
	}

	# Artwork lives on the server, never in the image (docs/adr/0003). File
	# names are not content-hashed, so images are cached for a day and the
	# manifest that lists them is always revalidated.
	handle_path /art/* {
		root * /srv/art
		@manifest path /manifest.json
		header @manifest Cache-Control "no-cache"
		@images not path /manifest.json
		header @images Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		reverse_proxy site:3000
	}
}
