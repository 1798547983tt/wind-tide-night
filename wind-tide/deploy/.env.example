# wind-tide: copy to .env on the server and fill in. Never commit .env.

# The address Caddy serves: https://<domain>, or https://<server IP> while the
# site has no domain (wind-tide/DEPLOY.md §7). api.example.com is a
# documentation placeholder.
SITE_ADDRESS=https://api.example.com
# The same address without https://. Browsers name no site when they open an
# IP address; Caddy then serves this one's certificate.
SITE_HOST=api.example.com

# The owner's Discord user ID; that Discord account signs in as the owner.
WT_OWNER_DISCORD_ID=

# Long random strings, made once with: openssl rand -hex 32
# Never change CRYPTO_SECRET afterwards: data encrypted with it would be lost.
SESSION_SECRET=
CRYPTO_SECRET=

# Over HTTPS: true, plus the exact address of the site.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://api.example.com

# Optional: the CLIProxyAPI account pool for donated accounts (DEPLOY.md §9).
# Leave both empty to hide the feature.
WT_CPA_URL=
WT_CPA_MANAGEMENT_KEY=

# Optional: the aistudio-api pool behind the AIS playground tab (DEPLOY.md §10).
# Leave all three empty to hide it.
WT_AIS_URL=
WT_AIS_PASSWORD=
WT_AIS_API_KEY=

# Optional: the AIStudioToAPI pool behind the BUILD tab (DEPLOY.md §11).
# Leave all three empty to hide it.
WT_BUILD_URL=
WT_BUILD_PASSWORD=
WT_BUILD_API_KEY=

# Optional: the workbuddy2api panel behind the WorkBuddy tab (DEPLOY.md §13).
# Leave both empty to hide it.
WT_WB_URL=
WT_WB_API_KEY=
