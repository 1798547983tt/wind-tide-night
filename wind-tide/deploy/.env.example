# wind-tide: copy to .env on the server and fill in. Never commit .env.

# The address Caddy serves: https://<server IP> until the site has a domain,
# then https://<domain>. 203.0.113.10 is a documentation placeholder.
SITE_ADDRESS=https://203.0.113.10

# The owner's Discord user ID; that Discord account signs in as the owner.
WT_OWNER_DISCORD_ID=

# Long random strings, made once with: openssl rand -hex 32
# Never change CRYPTO_SECRET afterwards: data encrypted with it would be lost.
SESSION_SECRET=
CRYPTO_SECRET=

# Over HTTPS: true, plus the exact address of the site.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://203.0.113.10
